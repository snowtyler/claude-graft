<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A tiny standalone launcher a desktop shortcut points at. Win32 GUI
         subsystem (WinExe) so no console window flashes when the shortcut is
         double-clicked; it applies the graft and starts Claude, then exits. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ClaudeGraft.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <!-- Self-contained like the app: a framework-dependent stub sends anyone
         without .NET 10 installed to a download page the first time a shortcut
         is opened, and installing that runtime would need admin. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeGraft.Core\ClaudeGraft.Core.csproj" />
  </ItemGroup>
</Project>
