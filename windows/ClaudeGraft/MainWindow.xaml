<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ClaudeGraft.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClaudeGraft"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ClaudeGraft"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The logo and wordmark live in the page header, so the title bar is
             just a drag region: no icon, no title text, only the caption buttons. -->
        <TitleBar x:Name="AppTitleBar" />

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
