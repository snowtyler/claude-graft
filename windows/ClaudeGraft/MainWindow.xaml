<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ClaudeGraft.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClaudeGraft"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Claude Graft"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The logo and wordmark live in the page header, so the title bar is
             just a drag region: no icon, no title text, only the caption buttons. -->
        <TitleBar x:Name="AppTitleBar" />

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <!-- The Mac window's sidebar: the Claudes, then what belongs to every
             account. The Claudes' page stays alive while another is shown. -->
        <NavigationView x:Name="Sections" Grid.Row="1" PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="240"
                        SelectionChanged="Sections_SelectionChanged" ItemInvoked="Sections_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader x:Name="ClaudesHeader" Content="Claudes" />
                <NavigationViewItem x:Name="NewClaudeItem" Content="New Claude…" Tag="new" SelectsOnInvoked="False"
                                    AutomationProperties.AutomationId="sidebar.newClaude"
                                    ToolTipService.ToolTip="Another Claude, with its own login and chats">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Every account" />
                <NavigationViewItem Content="Artifacts" Tag="artifacts"
                                    AutomationProperties.AutomationId="sidebar.artifacts">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Projects" Tag="projects"
                                    AutomationProperties.AutomationId="sidebar.projects">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search Chats" Tag="search"
                                    AutomationProperties.AutomationId="sidebar.search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" SelectsOnInvoked="False"
                                    AutomationProperties.AutomationId="sidebar.settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter>
                <!-- Claude's own version, here rather than across the top of a
                     page, where one line took the full width above every Claude. -->
                <local:ClaudeUpdateLine x:Name="UpdateLine" Stacked="True" Margin="16,8,12,8"
                                        RestartRequested="ClaudeRestart_Requested" />
            </NavigationView.PaneFooter>
            <Grid>
                <Frame x:Name="RootFrame" />
                <Frame x:Name="SectionFrame" Visibility="Collapsed" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
