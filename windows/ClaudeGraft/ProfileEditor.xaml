<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClaudeGraft.ProfileEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeGraft">

    <!-- A Claude's own settings, edited on its page. -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12">
        <StackPanel Spacing="14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="Name" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Twelve icons laid out here took more room than the rest,
                             so the one in use opens the others. -->
                        <Button x:Name="IconButton" AutomationProperties.AutomationId="profile.icon" Width="40" Height="32" Padding="2"
                                ToolTipService.ToolTip="Shortcut icon" AutomationProperties.Name="Shortcut icon">
                            <Image x:Name="IconImage" Width="24" Height="24" />
                            <Button.Flyout>
                                <Flyout x:Name="IconFlyout" Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="8" Width="324">
                                        <GridView x:Name="IconGrid" AutomationProperties.AutomationId="profile.iconGrid" SelectionMode="Single" IsItemClickEnabled="True"
                                                  ItemClick="IconGrid_ItemClick" AutomationProperties.Name="Shortcut icon">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="local:IconChoice">
                                                    <Image Source="{x:Bind Preview}" Width="38" Height="38" Margin="2"
                                                           ToolTipService.ToolTip="{x:Bind Title}" />
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                        <TextBlock Text="Used for the desktop shortcut and for this Claude's own button on the taskbar."
                                                   TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBox x:Name="NameBox" Grid.Column="1" AutomationProperties.Name="Name" AutomationProperties.AutomationId="profile.name"
                                 PlaceholderText="Work Account" TextChanged="NameBox_TextChanged" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Profile folder" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBox x:Name="FolderBox" FontFamily="Consolas" AutomationProperties.Name="Profile folder" AutomationProperties.AutomationId="profile.folder"
                             TextChanged="FolderBox_TextChanged" ToolTipService.ToolTip="Where this account's login, chats and settings are kept" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Text="Reads chats from" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Reads chats from" AutomationProperties.AutomationId="profile.source"
                          DisplayMemberPath="Label" SelectionChanged="SourceBox_SelectionChanged" />
            </StackPanel>

            <InfoBar x:Name="MergeNote" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="Histories are merged, not swapped"
                     Message="This profile keeps its own chats and gains the source's; both sidebars end up showing the combined set. The copies made into the source stay there — merging a history cannot be undone." />
            <InfoBar x:Name="Problem" IsOpen="False" IsClosable="False" Severity="Error" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Content="Delete Claude…" Click="Delete_Click" AutomationProperties.AutomationId="profile.delete" />
                <Button Grid.Column="2" x:Name="RevertButton" Content="Revert" Click="Revert_Click" AutomationProperties.AutomationId="profile.revert" />
                <Button Grid.Column="3" x:Name="SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Save Changes" AutomationProperties.AutomationId="profile.save">
                    <Grid>
                        <TextBlock x:Name="SaveText" Text="Save" HorizontalAlignment="Center" />
                        <ProgressRing x:Name="SaveRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                                      AutomationProperties.Name="Saving" />
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
