<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ClaudeGraft.ProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeGraft"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    CornerRadius="8"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    SecondaryButtonStyle="{StaticResource DialogNeutralButtonStyle}"
    CloseButtonStyle="{StaticResource DialogNeutralButtonStyle}">

    <!-- The dialog template rounds its surface from OverlayCornerRadius resolved
         at its own scope; an app-level override never reached it, so it is set
         here where the template will find it. Both this and the CornerRadius
         above are given, so the corners match the 8px used everywhere else
         whichever one the SDK's template reads. -->
    <ContentDialog.Resources>
        <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    </ContentDialog.Resources>

    <StackPanel Spacing="14" Width="380">
        <StackPanel Spacing="6">
            <TextBlock Text="Name" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Twelve icons laid out in the dialog took more room than the
                     rest of it, so the one in use opens the others. -->
                <Button x:Name="IconButton" Width="40" Height="32" Padding="2"
                        ToolTipService.ToolTip="Shortcut icon"
                        AutomationProperties.Name="Shortcut icon">
                    <Image x:Name="IconImage" Width="24" Height="24" />
                    <Button.Flyout>
                        <Flyout x:Name="IconFlyout" Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="8" Width="324">
                                <GridView x:Name="IconGrid" SelectionMode="Single" IsItemClickEnabled="True"
                                          ItemClick="IconGrid_ItemClick"
                                          AutomationProperties.Name="Shortcut icon">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="local:IconChoice">
                                            <Image Source="{x:Bind Preview}" Width="38" Height="38" Margin="2"
                                                   ToolTipService.ToolTip="{x:Bind Title}" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <TextBlock Text="Used for the desktop shortcut and for this Claude's own button on the taskbar."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBox x:Name="NameBox" Grid.Column="1" PlaceholderText="Work Account"
                         Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Profile folder" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBox x:Name="FolderBox" FontFamily="Consolas"
                     Text="{x:Bind Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Where this account's login, chats and settings are kept."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Reads chats from" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch"
                      DisplayMemberPath="Label"
                      SelectionChanged="SourceBox_SelectionChanged" />
        </StackPanel>

        <InfoBar x:Name="MergeNote" IsOpen="False" IsClosable="False" Severity="Warning"
                 Title="Histories are merged, not swapped"
                 Message="This profile keeps its own chats and gains the source's; both sidebars end up showing the combined set. The copies made into the source stay there — merging a history cannot be undone." />

        <InfoBar x:Name="Problem" IsOpen="False" IsClosable="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
