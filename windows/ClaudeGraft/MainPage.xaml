<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClaudeGraft.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeGraft"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: the logo and wordmark share a row with the actions, and the
             one-line description sits full-width beneath them. -->
        <Grid Grid.Row="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Image x:Name="LogoImage"
                           Width="52" Height="52" VerticalAlignment="Center" />
                    <TextBlock Text="Claude Graft" FontSize="36" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="AddButton" Click="Add_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add Profile" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh Usage" />
                        </StackPanel>
                    </Button>
                    <Button Click="Settings_Click" ToolTipService.ToolTip="Settings"
                            VerticalAlignment="Stretch">
                        <FontIcon Glyph="&#xE713;" FontSize="14" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="Extra Claude Desktop profiles, each with its own login and chats."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Profile list -->
        <Grid Grid.Row="1">
            <local:SetupPrompt x:Name="Setup" Visibility="Collapsed" />
            <ListView x:Name="ProfileList" ItemsSource="{x:Bind Rows}"
                      SelectionMode="None"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ShortcutRow">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                                     ToolTipService.ToolTip="{x:Bind StatusLabel, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        </StackPanel>
                                        <!-- Indented to sit under the title, past the dot and its gap. -->
                                        <TextBlock Margin="19,0,0,0"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="Chats:" />
                                            <Run Text="{x:Bind SourceLabel}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{x:Bind Folder}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Edit" Click="Edit_Click" Tag="{x:Bind}"
                                                Visibility="{x:Bind EditVisibility}" />
                                        <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind StartTooltip, Mode=OneWay}"
                                                Visibility="{x:Bind SignedInVisibility, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <ProgressRing IsActive="{x:Bind Starting, Mode=OneWay}"
                                                              Visibility="{x:Bind StartingVisibility, Mode=OneWay}"
                                                              Width="16" Height="16" VerticalAlignment="Center" />
                                                <Button Content="Start Session" Click="Start_Click" Tag="{x:Bind}"
                                                        Visibility="{x:Bind StartVisibility, Mode=OneWay}"
                                                        IsEnabled="{x:Bind StartEnabled, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="{x:Bind OpenLabel, Mode=OneWay}" Click="Open_Click" Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Plan usage -->
                                <StackPanel Spacing="6" Visibility="{x:Bind BarsVisibility, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind FiveHourText, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar Value="{x:Bind FiveHour, Mode=OneWay}" Maximum="100" />
                                    <TextBlock Text="{x:Bind WeekText, Mode=OneWay}" Margin="0,4,0,0"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar Value="{x:Bind Week, Mode=OneWay}" Maximum="100" />
                                    <StackPanel Spacing="6" Margin="0,4,0,0"
                                                Visibility="{x:Bind FableVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind FableText, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Value="{x:Bind Fable, Mode=OneWay}" Maximum="100" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{x:Bind SignInNote}"
                                           Visibility="{x:Bind SignInVisibility, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="No usage reported yet"
                                           Visibility="{x:Bind NoUsageVisibility, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind Problem, Mode=OneWay}"
                                           Visibility="{x:Bind ProblemVisibility, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                                <!-- Chats an account switch left in another profile: an offer to
                                     bring them over, standing for as long as any are still missing. -->
                                <Border Visibility="{x:Bind ElsewhereVisibility, Mode=OneWay}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Text="{x:Bind ElsewhereNote, Mode=OneWay}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <Button Grid.Column="1" VerticalAlignment="Center"
                                                Content="{x:Bind AdoptLabel, Mode=OneWay}"
                                                Click="Adopt_Click" Tag="{x:Bind}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{x:Bind CopiedNote, Mode=OneWay}"
                                           Visibility="{x:Bind CopiedNoteVisibility, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind SidebarStatus, Mode=OneWay}"
                                           Visibility="{x:Bind SidebarStatusVisibility, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <CheckBox Content="Keep the 5-hour window open automatically"
                                          Visibility="{x:Bind SignedInVisibility, Mode=OneWay}"
                                          IsChecked="{x:Bind KeepWarm, Mode=OneWay}"
                                          Click="KeepWarm_Click"
                                          Tag="{x:Bind}"
                                          ToolTipService.ToolTip="Sends one short message on its own whenever this account's window is found closed, so its five hours are always running." />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- Hint flows below the cards, never over them, while no extra
                     profiles exist yet. -->
                <ListView.Footer>
                    <TextBlock x:Name="EmptyState" Visibility="Collapsed"
                               Text="Add a profile to run a second account alongside Claude."
                               Margin="16,16,16,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </ListView.Footer>
            </ListView>
        </Grid>
    </Grid>
</Page>
