<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClaudeGraft.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClaudeGraft"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,24,36,36">
        <Grid RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="Basic WinUI 3 App" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
                <TextBlock Text="A showcase of modern Windows app design features including Mica backdrop and MSIX packaging." 
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Dashboard Grid -->
            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mica Backdrop Card -->
                <Border Grid.Column="0" Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="Mica Backdrop" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Mica is an opaque material that incorporates the user's theme and desktop wallpaper to create a highly personalized background. It is designed for application performance and only renders when the app is active." 
                                   TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                        
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <TextBlock Text="Backdrop Type:" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                            <ComboBox x:Name="BackdropComboBox" SelectionChanged="BackdropComboBox_SelectionChanged" SelectedIndex="0" Width="150">
                                <ComboBoxItem Content="Mica (Base)" />
                                <ComboBoxItem Content="Mica Alt" />
                                <ComboBoxItem Content="Acrylic" />
                                <ComboBoxItem Content="None" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MSIX Packaging Card -->
                <Border Grid.Column="1" Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE1A5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="MSIX Packaging" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="MSIX is the modern Windows app packaging format. It combines the best features of MSI, .appx, App-V, and ClickOnce to provide a reliable, secure, and performant packaging experience." 
                                   TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="PackageStatusText" FontWeight="SemiBold" Margin="0,8,0,0" Style="{StaticResource BodyTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- Interactive Demo Card -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock Text="Interactive Element" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Interact with this application directly. Click the button to update the counter, or toggle the application's color theme between Light and Dark modes." 
                                       TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
                            
                            <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,8,0,0">
                                <ToggleSwitch x:Name="ThemeToggle" Header="Application Theme" 
                                              OnContent="Dark" OffContent="Light" 
                                              Toggled="ThemeToggle_Toggled" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16" MinWidth="180" HorizontalAlignment="Center">
                            <TextBlock x:Name="CounterText" Text="Clicks: 0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                            <Button Content="Click Me!" Click="ClickMeButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="16,8" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
