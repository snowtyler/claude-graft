<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClaudeGraft.ClaudeUpdateLine"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One line, two when the words need them, so it never pushes the
         accounts below it down the way three lines and a button did. -->
    <Grid x:Name="Root" ColumnSpacing="10" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="Glyph" Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center" Visibility="Collapsed"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ProgressRing x:Name="Busy" Width="14" Height="14" MinWidth="0" MinHeight="0"
                          Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="Words" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       AutomationProperties.AutomationId="claudeUpdate.status" />
        </StackPanel>
        <ProgressRing x:Name="CheckBusy" Grid.Column="2" Width="16" Height="16" MinWidth="0" MinHeight="0" Margin="4,0"
                      Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
        <Button x:Name="CheckButton" Grid.Column="2" Click="Check_Click" Visibility="Collapsed" VerticalAlignment="Center"
                Padding="4" MinHeight="0" MinWidth="0" Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="Check for Claude Updates" AutomationProperties.Name="Check for Claude Updates"
                AutomationProperties.AutomationId="claudeUpdate.check">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
        <Button x:Name="ActionButton" Grid.Column="3" Click="Action_Click" Visibility="Collapsed"
                Padding="10,3" MinHeight="0" VerticalAlignment="Center"
                AutomationProperties.AutomationId="claudeUpdate.action" />
    </Grid>
</UserControl>
