<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ClaudeGraft.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Done"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DialogNeutralButtonStyle}">

    <!-- The Mac's settings: a heading over each group, its rows in one card,
         the name on the left and the control on the right; here on three pages,
         so the dialog fits the window without scrolling. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
        <!-- WinUI keeps a switch 154 wide for its On/Off words; without them it shrinks to the
             track, so it sits flush with the card's right edge as the Mac's does. -->
        <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
        <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
        <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style x:Key="SettingsRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,10,0,2" />
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <!-- The template keeps room after the track for its words; the switch sits in a slot the
                 track's width and that room hangs past it unclipped. -->
            <Setter Property="Margin" Value="0,0,-200,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="4" Width="440">
        <SelectorBar x:Name="Pages" SelectionChanged="Pages_SelectionChanged" Margin="-8,-8,0,0">
            <SelectorBarItem x:Name="AppearanceTab" Text="Appearance" IsSelected="True" AutomationProperties.AutomationId="settings.page.appearance" />
            <SelectorBarItem x:Name="GeneralTab" Text="General" AutomationProperties.AutomationId="settings.page.general" />
            <SelectorBarItem x:Name="UpdatesTab" Text="Updates" AutomationProperties.AutomationId="settings.page.updates" />
        </SelectorBar>

        <!-- One page at a time, in a height that holds the tallest, so the dialog keeps its size. -->
        <Grid Height="318">
            <StackPanel x:Name="AppearancePage">
                <TextBlock Text="Theme" Style="{StaticResource SettingsHeading}" Margin="2,4,0,6" />
                <GridView x:Name="PaletteGrid" SelectionMode="Single" Padding="0" Margin="0,0,-8,0"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Theme" AutomationProperties.AutomationId="settings.theme" />
                <Border Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Mode" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="ThemeBox" SelectionChanged="ThemeBox_SelectionChanged"
                                      AutomationProperties.Name="Mode" AutomationProperties.AutomationId="settings.mode" Width="170" VerticalAlignment="Center">
                                <ComboBoxItem Content="System" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource SettingsRule}" />
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Backdrop" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="BackdropBox" AutomationProperties.Name="Backdrop" AutomationProperties.AutomationId="settings.backdrop" Width="170" VerticalAlignment="Center">
                                <ComboBoxItem Content="Mica" />
                                <ComboBoxItem Content="Mica Alt" />
                                <ComboBoxItem Content="Acrylic" />
                                <ComboBoxItem Content="Solid" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                <TextBlock Text="Starting up" Style="{StaticResource SettingsHeading}" Margin="2,4,0,6" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="40"><ToggleSwitch x:Name="AutoStartSwitch" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Start with Windows" AutomationProperties.AutomationId="settings.startWithWindows" /></Grid>
                        </Grid>
                        <Border Style="{StaticResource SettingsRule}" />
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Start hidden in the notification area" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="40"><ToggleSwitch x:Name="StartHiddenSwitch" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Start hidden in the notification area" AutomationProperties.AutomationId="settings.startHidden" /></Grid>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="Taskbar and sound" Style="{StaticResource SettingsHeading}" Margin="2,14,0,6" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Show usage on the taskbar" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="The Claude in front, its usage and the conversation on screen, beside the notification area. Hidden while the taskbar hides itself, sits on a side, or a full-screen app is up." />
                            <Grid Grid.Column="1" Width="40"><ToggleSwitch x:Name="TaskbarStripSwitch" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Show usage on the taskbar" AutomationProperties.AutomationId="settings.taskbarStrip" /></Grid>
                        </Grid>
                        <Border Style="{StaticResource SettingsRule}" />
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Chime when a Claude is ready" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="A sound when a Claude that is not in front finishes a turn, and a stronger one when it waits on a permission or a question. Adds an entry to Claude Code's settings, taken out again when this is turned off." />
                            <Grid Grid.Column="1" Width="40"><ToggleSwitch x:Name="ChimeSwitch" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Chime when a Claude is ready" AutomationProperties.AutomationId="settings.chime" /></Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
                <StackPanel x:Name="ManualClaudeRow">
                    <TextBlock Text="Claude" Style="{StaticResource SettingsHeading}" Margin="2,4,0,6" />
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Update Claude only when I ask" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Turns off Claude's own automatic updates for every profile, so it never quits mid-task to install one. Claude Desktop's line in the flyout installs updates instead. Takes effect the next time each Claude opens." />
                            <Grid Grid.Column="1" Width="40"><ToggleSwitch x:Name="ManualClaudeSwitch" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Update Claude only when I ask" AutomationProperties.AutomationId="settings.manualClaudeUpdates" /></Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                <TextBlock Text="Claude Graft" Style="{StaticResource SettingsHeading}" x:Name="GraftUpdatesHeading" Margin="2,14,0,6" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingsRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Hold Graft's updates until I install them" VerticalAlignment="Center"
                                       ToolTipService.ToolTip="Off, updates install on their own and Graft restarts itself. On, a new version waits for you to press Install." />
                            <Grid Grid.Column="1" Width="40"><ToggleSwitch x:Name="HoldUpdatesSwitch" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Hold Graft's updates until I install them" AutomationProperties.AutomationId="settings.holdUpdates" /></Grid>
                        </Grid>
                        <Border Style="{StaticResource SettingsRule}" />
                        <Grid Style="{StaticResource SettingsRow}" Padding="14,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="VersionText" />
                                <TextBlock x:Name="UpdateStatus" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{StaticResource GraftTextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="CheckButton" Grid.Column="1" Content="Check for Updates" AutomationProperties.AutomationId="settings.checkUpdates"
                                    Click="Check_Click" Padding="12,4" MinHeight="0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Text="Graft keeps reporting usage in the notification area after its window is closed. Quit it from the notification area icon."
                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{StaticResource GraftTextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Margin="4,2,4,0" />
    </StackPanel>
</ContentDialog>
