<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClaudeGraft.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="16,10" ColumnSpacing="8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{StaticResource GraftTextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="Projects" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <Button Style="{StaticResource InfoGlyphButton}" Grid.Column="2"
                    AutomationProperties.Name="About Projects" AutomationProperties.AutomationId="projects.info"
                    ToolTipService.ToolTip="About Projects">
                <FontIcon Glyph="&#xE946;" FontSize="14" />
                <Button.Flyout>
                    <Flyout>
                        <TextBlock x:Name="NoteText" MaxWidth="360" TextWrapping="Wrap" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <ScrollViewer Grid.Column="3" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AccountChips" Orientation="Horizontal" Spacing="6" />
            </ScrollViewer>
            <Button Grid.Column="4" x:Name="AddAccountButton" Click="AddAccount_Click"
                    AutomationProperties.AutomationId="projects.addAccount" AutomationProperties.Name="Add Account"
                    ToolTipService.ToolTip="Sign in to another claude.ai account">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Name="AddAccountText" Text="Add Account…" />
                </StackPanel>
            </Button>
            <Button Grid.Column="5" x:Name="RefreshButton" Click="Refresh_Click" Padding="8" Background="{ThemeResource GraftQuietBrush}" BorderThickness="0"
                    ToolTipService.ToolTip="Ask claude.ai for every account's projects again"
                    AutomationProperties.Name="Refresh Projects" AutomationProperties.AutomationId="projects.refresh">
                <Grid>
                    <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="14" />
                    <ProgressRing x:Name="RefreshRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                                  AutomationProperties.Name="Asking claude.ai" />
                </Grid>
            </Button>
        </Grid>

        <Grid Grid.Row="1" x:Name="FilterBar" Padding="16,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" PlaceholderText="Filter" TextChanged="Filter_Changed"
                     AutomationProperties.Name="Filter Projects" AutomationProperties.AutomationId="projects.filter" />
            <TextBlock Grid.Column="1" x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource GraftTextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="projects.count" />
        </Grid>

        <StackPanel Grid.Row="2" x:Name="SignedOutPanel" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8B7;" FontSize="34" Foreground="{StaticResource GraftTextFillColorTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Sign in to see projects" HorizontalAlignment="Center" AutomationProperties.AutomationId="projects.signInNote" />
            <Button Content="Sign In…" HorizontalAlignment="Center" Click="AddAccount_Click" AutomationProperties.AutomationId="projects.signIn" />
            <TextBlock x:Name="SignInHint" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{StaticResource GraftTextFillColorSecondaryBrush}" AutomationProperties.AutomationId="projects.signInHint" />
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   Foreground="{StaticResource GraftTextFillColorSecondaryBrush}" AutomationProperties.AutomationId="projects.empty" />
        <ListView Grid.Row="2" x:Name="ProjectList" SelectionMode="None" Padding="8,0" />

        <Grid Grid.Row="3" x:Name="TroubleBar" Padding="16,10" BorderThickness="0,1,0,0" Visibility="Collapsed"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock x:Name="TroubleText" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource GraftTextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="projects.status" />
        </Grid>
    </Grid>
</Page>
