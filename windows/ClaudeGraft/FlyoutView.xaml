<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClaudeGraft.FlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeGraft"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="340"
    mc:Ignorable="d">

    <!-- The rounded, hairline-bordered panel the acrylic shows through. The
         window itself is borderless, so the shape lives here. -->
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <!-- Profiles. Capped so a long list scrolls rather than growing the
                 flyout past the screen. -->
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind Rows}" Padding="8,8,8,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ShortcutRow">
                        <StackPanel Spacing="8" Padding="8,10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                         VerticalAlignment="Center"
                                         Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button Grid.Column="2" Content="Open" Click="Open_Click" Tag="{x:Bind}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="16,4" MinHeight="0" />
                            </Grid>

                            <StackPanel Spacing="4" Visibility="{x:Bind BarsVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind FiveHourText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar Value="{x:Bind FiveHour, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{x:Bind WeekText, Mode=OneWay}" Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar Value="{x:Bind Week, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                            <TextBlock Text="No usage reported yet"
                                       Visibility="{x:Bind NoUsageVisibility, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- Actions -->
            <Border Height="1" Margin="8,4"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Padding="8,4,8,8">
                <Button Click="Manager_Click" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent"
                        BorderThickness="0" Content="Open Claude Graft" Padding="10,8" />
                <Button Click="Quit_Click" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent"
                        BorderThickness="0" Content="Quit Claude Graft" Padding="10,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
