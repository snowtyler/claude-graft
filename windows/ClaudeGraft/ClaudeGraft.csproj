<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClaudeGraft</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Embedded into the executable itself, which is where the taskbar button
         and the Start-menu shortcut take their icon from — not from the window's
         own SetIcon, so without this they fall back to the generic host icon. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The app installs unpackaged, so the only icon the OS reads is the one
       embedded in the executable by ApplicationIcon above; the tile and logo
       PNGs a package manifest would name are not consulted without package
       identity, so they are neither generated nor shipped. -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeGraft.Core\ClaudeGraft.Core.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!-- The installer is unpackaged and copies a plain folder into place, so the
         app cannot lean on a Windows App SDK runtime framework package being
         registered at the right version — the machine may carry a newer one or
         none at all, and the deployment initializer throws REGDB_E_CLASSNOTREG
         when its own version is missing. Carrying the runtime in the bundle
         removes that dependency entirely. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Never trimmed. The trimmer cannot see through the WinRT interop the XAML
         bindings marshal across (an ObservableCollection bound as ItemsSource
         throws in GetInterfaceTableEntries) or the reflection System.Text.Json
         uses, so a trimmed build comes up with an empty window and no profiles
         while raising no error a build would catch. Size is the cheaper cost. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- And no ahead-of-time interop either. The CsWinRT optimizer bakes a
         vtable-lookup initializer that this SDK's generated code loads against a
         ComInterfaceEntry type the runtime here does not carry, so an untrimmed
         build faults at startup before the tray icon appears; ReadyToRun pulls
         in the same path. Classic reflection-based marshaling is what works. -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!--
    The launcher stub a desktop shortcut points at has to travel with the app,
    so it can be copied to its stable spot on a machine that never saw the repo.
    Publish it into the app's output under launcher\ after each build, so the
    installer that copies the output folder into place carries it along, and
    EnsureLauncher finds it at BaseDirectory\launcher in dev and once installed
    alike.
  -->
  <!-- The window sets its taskbar icon from a loose file on disk, but the icon
       otherwise ships only packed into the app's resources; copy it out beside
       the binary so an unpackaged install has the real file to point at. -->
  <Target Name="CopyLooseIcon" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets\AppIcon.ico" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" Condition="'$(PublishDir)' == ''" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets\AppIcon.ico" DestinationFolder="$(PublishDir)Assets" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <Target Name="BundleLauncher" AfterTargets="Build">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\GraftLaunch\GraftLaunch.csproj&quot; -c $(Configuration) -o &quot;$(OutDir)launcher&quot; --nologo -v q" />
  </Target>

  <!-- The publish output is a different folder from the build output, and it is
       what an unpackaged install is copied from, so the stub is placed there too. -->
  <Target Name="BundleLauncherOnPublish" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\GraftLaunch\GraftLaunch.csproj&quot; -c $(Configuration) -o &quot;$(PublishDir)launcher&quot; --nologo -v q" />
  </Target>
</Project>